<?xml version="1.0" encoding="utf-8"?>
<!-- Floating input bar used to type into the OpenCode TUI without fighting with the
     terminal view for the soft keyboard. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/opencode_prompt_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="?attr/termuxActivityDrawerBackground"
    android:paddingStart="8dp"
    android:paddingEnd="4dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <EditText
        android:id="@+id/opencode_prompt_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@null"
        android:hint="@string/opencode_prompt_hint"
        android:imeOptions="actionSend|flagNoExtractUi"
        android:inputType="text|textMultiLine|textCapSentences"
        android:maxLines="4"
        android:textColor="@android:color/white"
        android:textColorHint="@android:color/darker_gray"
        android:textSize="15sp" />

    <Button
        android:id="@+id/opencode_prompt_send"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:text="@string/opencode_prompt_send" />

</LinearLayout>
