<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog showing the progress of the OpenCode installation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/opencode_install_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/opencode_installing"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/opencode_install_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/opencode_install_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:max="100"
        android:progress="0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/opencode_install_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/opencode_install_bytes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:gravity="end|center_vertical"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/opencode_install_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/opencode_install_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/opencode_install_steps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/opencode_install_log_background"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp"
        android:padding="10dp"
        android:textSize="11sp"
        android:typeface="monospace" />

</LinearLayout>
